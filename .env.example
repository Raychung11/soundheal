# SoundHeal — environment configuration template.
# Copy to .env (or set in your hosting panel) before running in production.

APP_NAME=SoundHeal
APP_ENV=production
APP_DEBUG=false
APP_URL=https://soundheal.example.com
APP_TIMEZONE=Asia/Kuala_Lumpur

# --- Database -----------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=soundheal
DB_USER=soundheal
DB_PASS=change-me

# --- Mail ---------------------------------------------------------
MAIL_DRIVER=smtp
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=587
MAIL_USERNAME=no-reply@soundheal.example.com
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@soundheal.example.com
MAIL_FROM_NAME=SoundHeal

# --- Cookies / sessions -------------------------------------------
COOKIE_SECURE=true

# --- Billplz ------------------------------------------------------
BILLPLZ_SANDBOX=true
BILLPLZ_API_KEY=
BILLPLZ_COLLECTION_ID=
BILLPLZ_X_SIGNATURE=

# --- AI -----------------------------------------------------------
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- WhatsApp / Evolution API -------------------------------------
WA_DRIVER=evolution
WA_BASE_URL=
WA_API_KEY=
WA_INSTANCE=soundheal
WA_WEBHOOK_SECRET=
