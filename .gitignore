.env
.env.*
!.env.example

logs/*.log
logs/*.txt

# Ignore user-uploaded media but keep the bucket directories so the
# app can write into them on a fresh clone. .htaccess is un-ignored
# too so per-bucket Apache rules ship with the repo
# (uploads/content/.htaccess relies on this).
uploads/*
!uploads/.gitkeep
!uploads/*/
uploads/*/*
!uploads/*/.gitkeep
!uploads/*/.htaccess

qr/*
!qr/.gitkeep

vendor/
composer.lock
node_modules/

.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
